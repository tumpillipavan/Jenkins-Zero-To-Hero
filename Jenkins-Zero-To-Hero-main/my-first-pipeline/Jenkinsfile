// Jenkinsfile
node {
  
  // 1) Checkout source code from SCM (Git, etc.)
  stage('Checkout') {
    checkout scm
  }

  // 2) Run your steps inside a Docker container
  stage('Test in Docker') {
    script {
      // Pull the Node.js Docker image (lightweight version)
      def img = docker.image('node:16-alpine')

      img.pull()  // Make sure it's up to date

      // Run the following inside the container
      img.inside(
        // Mount only your Jenkins workspace into /workspace
        "-v ${env.WORKSPACE}:/workspace -w /workspace"
      ) {
        // Now you're inside the Docker container at /workspace
        sh 'node --version'  // Check node version
        sh 'npm install'     // Example: install dependencies
        sh 'npm test'        // Example: run tests
      }
    }
  }
}

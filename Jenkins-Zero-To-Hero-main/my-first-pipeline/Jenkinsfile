// my-first-pipeline/Jenkinsfile
node {

  // 1) Checkout your code
  stage('Checkout') {
    checkout scm
  }

  // 2) Run inside Docker, with only your mounts
  stage('Test in Docker') {
    script {
      // define the image
      def img = docker.image('node:16-alpine')

      // pull it if needed
      img.pull()

      // run commands inside, mounting only the Unix-style path you control
      img.inside(
        // mount the Windows workspace into /workspace in the container
        "-v /c/ProgramData/Jenkins/.jenkins/workspace/Zero-to-hero:/workspace " +
        // set that as the working dir
        "-w /workspace"
      ) {
        // now this runs in /workspace, with no conflicting Windows paths
        sh 'node --version'
      }
    }
  }
}

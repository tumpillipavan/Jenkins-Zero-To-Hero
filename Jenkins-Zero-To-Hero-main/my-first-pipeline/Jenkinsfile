pipeline {
  agent {
    docker {
      image 'node:16-alpine'
      // map the Windows workspace into /workspace inside the container
      args  '-v /c/ProgramData/Jenkins/.jenkins/workspace/Zero-to-hero:/workspace' +
            ' -w /workspace'
    }
  }
  stages {
    stage('Test') {
      steps {
        // inside a Linux container, use sh
        sh 'node --version'
      }
    }
  }
}

